# Postgres connection string from Neon (https://neon.tech)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob read/write token (Storage > Blob in the Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# Shared password that gates viewing the whole site
SITE_PASSWORD=

# Separate password that unlocks admin (create/edit/delete) affordances
ADMIN_PASSWORD=

# Random secret used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
